# Supabase project settings — Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import this in client code or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings — Project Settings > Database in Supabase.
# DATABASE_URL: the pooled connection (port 6543, pgbouncer) — used at runtime.
DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL: the direct connection (port 5432) — used by `prisma migrate` / `prisma studio` only.
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32-byte key, base64-encoded, for AES-256-GCM encryption of participant
# contact details (src/lib/crypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONTACT_ENCRYPTION_KEY=

# Current informed-consent document version shown to participants.
CONSENT_VERSION=1.0

# Institutional ethics/IRB approval reference. An experiment cannot be set
# to ACTIVE without one recorded (see src/app/researcher/experiments/new).
ETHICS_APPROVAL_REF=
