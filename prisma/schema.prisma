// LiveDrop Arena — research data model.
// Connection URLs live in prisma.config.ts (Migrate/Studio) and in the
// PrismaClient driver adapter (runtime) — see src/lib/prisma.ts. Prisma 7
// no longer supports `url` / `directUrl` in the datasource block.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  RESEARCHER
  STREAMER
  PARTICIPANT
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique
  name       String
  email      String   @unique
  role       Role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  experiments Experiment[] @relation("ExperimentResearcher")
  streamer    Streamer?

  assignedContacts    ContactWorkflow[]
  contactAttempts     ContactAttempt[]
  interviewsConducted Interview[]
  exclusionsMade      ResearchEligibility[]

  collaborations       ExperimentCollaborator[]
  auditEntries         AuditLog[]
  policyDecisions      StudyPolicyDecision[]
  sessionConfigs       SessionConfig[]
  permissionRecords    DataUsePermission[]
  submissionFollowUps  SubmissionFollowUp[]
  submissionAttempts   SubmissionContactAttempt[]
  submissionInterviews SubmissionInterview[]
  draws                RewardDraw[]
  payoutUpdates        DrawWinner[]
  platformMetrics      PlatformMetric[]
  sessionAnnotations   SessionAnnotation[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Experiments
// ---------------------------------------------------------------------------

enum ExperimentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Experiment {
  id                String           @id @default(uuid())
  title             String
  description       String
  objective         String
  status            ExperimentStatus @default(DRAFT)
  startDate         DateTime
  endDate           DateTime?
  // Required before status may transition to ACTIVE — enforced in the
  // experiment status-change server action, not just at the schema level.
  ethicsApprovalRef String?

  researcherId String
  researcher   User   @relation("ExperimentResearcher", fields: [researcherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Revised (session-configured) flow: duplicates are matched by normalized
  // phone within this whole campaign. Kept as an explicit column rather than
  // an implicit global rule so a future study can choose differently.
  duplicateScope DuplicateScope @default(CAMPAIGN)

  streamers      ExperimentStreamer[]
  conditions     Condition[]
  participants   Participant[]
  surveys        Survey[]
  trackingLinks  TrackingLink[]
  streamSessions StreamSession[]

  collaborators   ExperimentCollaborator[]
  policyDecisions StudyPolicyDecision[]
  visits          Visit[]
  submissions     Submission[]
  phoneEntries    CampaignPhoneEntry[]
  studyEvents     StudyEvent[]
  draws           RewardDraw[]

  @@index([researcherId])
  @@map("experiments")
}

// Join table: which streamers are assigned to recruit for which experiment.
model ExperimentStreamer {
  id           String   @id @default(uuid())
  experimentId String
  streamerId   String
  assignedAt   DateTime @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  streamer   Streamer   @relation(fields: [streamerId], references: [id], onDelete: Cascade)

  @@unique([experimentId, streamerId])
  @@map("experiment_streamers")
}

// A randomly-assigned variant of the stimulus. This is what turns the
// platform into a factorial experiment rather than a single fixed page —
// each toggle corresponds 1:1 to a persuasion element in the stimulus UI.
model Condition {
  id                     String             @id @default(uuid())
  experimentId           String
  name                   String
  urgencyEnabled         Boolean            @default(false)
  socialProofEnabled     Boolean            @default(false)
  authorityBadgesEnabled Boolean            @default(false)
  rewardRarity           Rarity             @default(COMMON)
  contactRequirement     ContactRequirement @default(OPTIONAL)

  experiment   Experiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  participants Participant[]

  createdAt DateTime @default(now())

  @@index([experimentId])
  @@map("conditions")
}

enum Rarity {
  COMMON
  RARE
  EXCEPTIONAL
  PREMIUM
}

enum ContactRequirement {
  OPTIONAL
  REQUIRED
}

// ---------------------------------------------------------------------------
// Streamers
// ---------------------------------------------------------------------------

enum StreamerStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Streamer {
  id          String         @id @default(uuid())
  userId      String         @unique
  displayName String
  platform    String
  channelUrl  String
  category    String
  // Researcher-approved image shown on the streamer-branded homepage. A
  // session's config snapshot copies it, so later edits don't rewrite history.
  imageUrl    String?
  status      StreamerStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  experiments    ExperimentStreamer[]
  trackingLinks  TrackingLink[]
  // Self-reported "which streamer are you watching" on Participant, not the
  // tracking-link click-through relation above.
  viewers        Participant[]
  streamSessions StreamSession[]

  @@map("streamers")
}

// ---------------------------------------------------------------------------
// Participants — anonymous by design. No account, no session-based identity.
// ---------------------------------------------------------------------------

enum ConsentStatus {
  PENDING
  GRANTED
  DECLINED
}

model Participant {
  id             String        @id @default(uuid())
  experimentId   String
  conditionId    String?
  // Which streamer's link brought this participant in — visit/conversion
  // counts for a TrackingLink are derived from this relation rather than
  // kept in a separate counter table.
  trackingLinkId String?
  // Self-reported at entry-submission time (which streamer's stream they're
  // watching) — distinct from trackingLinkId, since a participant can visit
  // via one streamer's link but actually be watching another, or arrive with
  // no link at all. This is the field the per-streamer contact-dedup check
  // (see submitEntry) is scoped by.
  streamerId     String?
  anonymousCode  String        @unique
  consentStatus  ConsentStatus @default(PENDING)
  // Which reward the roulette showed/awarded this participant at claim time.
  rewardLabel    String?
  rewardRarity   Rarity?
  createdAt      DateTime      @default(now())

  experiment   Experiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  condition    Condition?    @relation(fields: [conditionId], references: [id])
  trackingLink TrackingLink? @relation(fields: [trackingLinkId], references: [id])
  streamer     Streamer?     @relation(fields: [streamerId], references: [id])

  // Contact details live in a separate, independently-deletable table —
  // never joined into analytics queries.
  contact         ParticipantContact?
  consent         Consent?
  debrief         Debrief?
  responses       Response[]
  events          EngagementEvent[]
  supportRequests SupportRequest[]

  // Researcher-workflow state — deliberately separate from ParticipantContact
  // (see ContactWorkflow) so it survives the PII purge on debrief decline.
  contactWorkflow     ContactWorkflow?
  contactAttempts     ContactAttempt[]
  interviewConsent    InterviewConsent?
  interviews          Interview[]
  researchEligibility ResearchEligibility?

  @@index([experimentId])
  @@index([conditionId])
  @@index([trackingLinkId])
  @@index([streamerId])
  @@map("participants")
}

// Deliberately split from Participant so a debrief decline (see Debrief
// below) can delete this row alone, without touching behavioural data used
// in aggregate analysis.
model ParticipantContact {
  id                  String   @id @default(uuid())
  participantId       String   @unique
  // Encrypted at rest with AES-256-GCM (see src/lib/crypto.ts). Never
  // decrypted for display in the researcher dashboard — only for an
  // outbound contact action a human researcher explicitly triggers.
  // Both may be set — some reward types (e.g. bKash) can only be paid out
  // by phone, so email alone isn't always enough for follow-up.
  encryptedValue      String
  encryptedPhone      String?
  // Deterministic HMAC of the normalized email (see src/lib/crypto.ts) —
  // never the plaintext, but lets submitEntry look up "has this email
  // already submitted for this streamer" without decrypting anything.
  emailHash           String?
  streamNickname      String?
  favouriteGameType   String?
  livestreamFrequency String?
  createdAt           DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([emailHash])
  @@map("participant_contacts")
}

model Consent {
  id             String    @id @default(uuid())
  participantId  String    @unique
  consentGiven   Boolean
  consentVersion String
  timestamp      DateTime  @default(now())
  // Set independently of the original consentGiven value — e.g. a
  // researcher recording a later phone-call withdrawal, unrelated to the
  // participant's own on-page debrief answer.
  withdrawn      Boolean   @default(false)
  withdrawnAt    DateTime?
  notes          String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// The retroactive-consent mechanism required because the stimulus uses
// deception. `permissionGiven = false` triggers deletion of
// ParticipantContact and exclusion of this participant from analysis.
model Debrief {
  id               String         @id @default(uuid())
  participantId    String         @unique
  explanationShown Boolean        @default(true)
  permissionGiven  Boolean?
  timestamp        DateTime       @default(now())
  // Researcher-side human-follow-up debrief workflow (phone/WhatsApp/SMS) —
  // separate from the automatic on-page explanation above. submitDebrief
  // auto-sets this to ACKNOWLEDGED/DECLINED the moment a participant
  // completes the on-page flow themselves; the other states are reached
  // only through the researcher's own Debrief-queue actions, for
  // participants who never got that far on their own.
  debriefStatus    DebriefStatus  @default(PENDING)
  debriefMethod    DebriefMethod?
  debriefSentAt    DateTime?
  debriefNotes     String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("debriefs")
}

enum DebriefStatus {
  PENDING
  CONTACTED
  EXPLAINED
  ACKNOWLEDGED
  DECLINED
  UNREACHABLE
}

enum DebriefMethod {
  PHONE_CALL
  WHATSAPP
  SMS
  OTHER
}

// ---------------------------------------------------------------------------
// Surveys
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  LIKERT
  RATING
  TEXT
}

model Survey {
  id           String  @id @default(uuid())
  experimentId String
  title        String
  description  String?

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  questions  Question[]
  responses  Response[]

  @@index([experimentId])
  @@map("surveys")
}

model Question {
  id           String       @id @default(uuid())
  surveyId     String
  questionText String
  questionType QuestionType
  // For MULTIPLE_CHOICE / LIKERT: string[] of option labels. Null otherwise.
  options      Json?
  order        Int

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("questions")
}

model Response {
  id            String   @id @default(uuid())
  surveyId      String
  participantId String
  // { [questionId]: string | number }
  answers       Json
  submittedAt   DateTime @default(now())

  survey      Survey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([surveyId, participantId])
  @@map("responses")
}

// ---------------------------------------------------------------------------
// Tracking / research links and anonymous engagement events
// ---------------------------------------------------------------------------

// One streamer broadcast/campaign a set of tracking links can be scoped to
// — lets the researcher compare recruitment effectiveness by session (QR
// overlay vs. chat-pinned link vs. description link all point at the same
// StreamSession via separate TrackingLink rows).
model StreamSession {
  id                   String    @id @default(uuid())
  experimentId         String
  streamerId           String
  platform             String?
  gameName             String?
  streamTitle          String?
  streamStartTime      DateTime?
  streamEndTime        DateTime?
  campaignStartTime    DateTime?
  campaignEndTime      DateTime?
  estimatedViewerCount Int?
  qrDisplayed          Boolean   @default(false)
  chatLinkPosted       Boolean   @default(false)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // --- Revised study flow --------------------------------------------------
  // streamStartTime/streamEndTime above are the *planned* times; the actual
  // times below are recorded by the researcher and drive the entry deadline.
  sessionType     StreamSessionType   @default(STUDY)
  status          StreamSessionStatus @default(DRAFT)
  collectionMode  CollectionMode      @default(TEST)
  actualStartAt   DateTime?
  actualEndAt     DateTime?
  // Always actualEndAt + 2h, written together with actualEndAt; null until
  // the actual end is recorded (no invented deadline).
  entryDeadlineAt DateTime?
  // Manual "close entries now" — takes effect even before the deadline.
  entriesClosedAt DateTime?
  activatedAt     DateTime?
  currentConfigId String?             @unique

  experiment    Experiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  streamer      Streamer       @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  trackingLinks TrackingLink[]

  currentConfig   SessionConfig?        @relation("CurrentSessionConfig", fields: [currentConfigId], references: [id])
  configs         SessionConfig[]       @relation("SessionConfigs")
  visits          Visit[]
  submissions     Submission[]
  studyEvents     StudyEvent[]
  spins           SpinOutcome[]
  annotations     SessionAnnotation[]
  platformMetrics PlatformMetric[]
  timingChanges   SessionTimingChange[]

  @@index([experimentId])
  @@index([streamerId])
  @@map("stream_sessions")
}

enum EntrySource {
  STREAM_QR
  STREAM_CHAT_LINK
  STREAM_DESCRIPTION
  DIRECT
  OTHER
}

model TrackingLink {
  id              String      @id @default(uuid())
  experimentId    String
  streamerId      String?
  streamSessionId String?
  // STREAM_QR/STREAM_CHAT_LINK/STREAM_DESCRIPTION require a streamSessionId
  // — enforced in the create/update actions, not at the schema level.
  entrySource     EntrySource @default(OTHER)
  uniqueCode      String      @unique
  createdAt       DateTime    @default(now())

  experiment    Experiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  streamer      Streamer?      @relation(fields: [streamerId], references: [id])
  streamSession StreamSession? @relation(fields: [streamSessionId], references: [id])
  participants  Participant[]
  visits        Visit[]
  submissions   Submission[]

  @@index([experimentId])
  @@index([streamSessionId])
  @@map("tracking_links")
}

enum EngagementEventType {
  PAGE_VIEW
  CTA_CLICKED
  SPIN_CLICKED
  MODAL_OPENED
  OPTION_SELECTED
  FIELD_FOCUSED
  CONTACT_SUBMITTED
  STUDY_COMPLETED
  SURVEY_SUBMITTED
  // Legacy — no longer written by new code, kept so historical rows stay
  // valid. Previously fired identically by three unrelated actions; see
  // CONTACT_SUBMITTED / STUDY_COMPLETED / SURVEY_SUBMITTED above.
  SUBMITTED
  ABANDONED
}

// Minimal, anonymous funnel telemetry keyed only to a participant's
// anonymous code — never an IP address, user agent, or referrer.
model EngagementEvent {
  id            String              @id @default(uuid())
  participantId String
  type          EngagementEventType
  // Which page/section this happened on, and the element/value involved —
  // e.g. page="landing", element="cta-hero", or page="claim-modal",
  // element="favouriteGameType", eventValue="Mobile Battle Royale".
  page          String?
  element       String?
  eventValue    String?
  metadata      Json?
  timestamp     DateTime            @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("engagement_events")
}

// ---------------------------------------------------------------------------
// Stimulus content — editable copy for the public participant-facing pages.
// Singleton row (id is always "singleton"); config.ts holds the seed-time
// defaults only, this table is the runtime source of truth.
// ---------------------------------------------------------------------------

model SiteContent {
  id                    String   @id @default("singleton")
  siteName              String   @default("LiveDrop Arena")
  siteDescription       String   @default("Academic research prototype studying livestream gaming recruitment and disclosure behaviour.")
  heroHeadline          String
  heroSubtext           String
  claimedCount          String
  countdownSeconds      Int
  trustBadges           Json // { icon, title, description }[]
  gameCategories        Json // { tag, title, description }[]
  rewardPool            Json // { label, sub, rarity }[]
  gameTypeOptions       Json // string[]
  watchFrequencyOptions Json // string[]
  faqItems              Json // { q, a }[]
  navContent            Json     @default("{}") // { links: { href, label }[], ctaLabel }
  footerContent         Json     @default("{}") // { links: { href, label }[], copyrightText, disclaimerText }
  aboutContent          Json     @default("{}")
  supportContent        Json     @default("{}")
  termsContent          Json     @default("{}")
  debriefContent        Json     @default("{}")
  entryReceivedContent  Json     @default("{}")
  updatedAt             DateTime @updatedAt

  @@map("site_content")
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

// Participant-initiated contact-support requests from the stimulus/support
// page. Kept separate from ParticipantContact — support messages are
// operational, not behavioural research data.
model SupportRequest {
  id                String    @id @default(uuid())
  participantId     String?
  // Legacy plaintext columns — new requests leave these null and use the
  // encrypted* columns below; scripts/encrypt-support-requests.ts moves
  // existing rows over.
  emailOrPhone      String?
  responseCode      String?
  streamNickname    String?
  issueType         String
  message           String?
  encryptedContact  String?
  encryptedMessage  String?
  encryptedNickname String?
  purgedAt          DateTime?
  createdAt         DateTime  @default(now())

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@map("support_requests")
}

// ---------------------------------------------------------------------------
// Outreach — human-follow-up contact, debrief queue, interviews, and the
// final research-eligibility decision. All 1:1 with Participant except
// ContactAttempt/Interview (append-only / re-schedulable history), and all
// deliberately separate from ParticipantContact so this researcher-workflow
// state survives the PII purge on debrief decline.
// ---------------------------------------------------------------------------

enum ContactStatus {
  NOT_CONTACTED
  CONTACTED
  DEBRIEFED
  INTERVIEW_INVITED
  INTERVIEW_COMPLETED
  UNREACHABLE
}

enum PrizeFulfillmentStatus {
  SELECTED
  WON
  CLAIMED
  NOT_CLAIMED
  DELIVERED
}

model ContactWorkflow {
  id                      String                  @id @default(uuid())
  participantId           String                  @unique
  contactStatus           ContactStatus           @default(NOT_CONTACTED)
  preferredContactChannel String?
  nextFollowupAt          DateTime?
  researcherAssignedId    String?
  // "Prize" itself is Participant.rewardLabel/rewardRarity (already set at
  // claim time) — this is only the fulfillment/delivery workflow state.
  prizeFulfillmentStatus  PrizeFulfillmentStatus?
  prizeDeliveredAt        DateTime?
  contactNotes            String?
  updatedAt               DateTime                @updatedAt

  participant        Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  researcherAssigned User?       @relation(fields: [researcherAssignedId], references: [id])

  @@map("contact_workflows")
}

enum ContactOutcome {
  ANSWERED
  NO_ANSWER
  WRONG_NUMBER
  CALL_BACK_LATER
  DEBRIEF_COMPLETED
  DECLINED
  UNREACHABLE
}

// Append-only log — contactAttemptCount/firstContactedAt/lastContactedAt are
// derived from this (count/min/max) rather than stored as separate counters.
model ContactAttempt {
  id            String         @id @default(uuid())
  participantId String
  attemptedAt   DateTime       @default(now())
  outcome       ContactOutcome
  note          String?
  researcherId  String?

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  researcher  User?       @relation(fields: [researcherId], references: [id])

  @@index([participantId])
  @@map("contact_attempts")
}

enum InterviewConsentAnswer {
  PENDING
  YES
  NO
}

enum InterviewCandidateStatus {
  NOT_INVITED
  INVITED
  ACCEPTED
  DECLINED
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model InterviewConsent {
  id                   String                   @id @default(uuid())
  participantId        String                   @unique
  invited              Boolean                  @default(false)
  invitedAt            DateTime?
  consent              InterviewConsentAnswer   @default(PENDING)
  consentAt            DateTime?
  status               InterviewCandidateStatus @default(NOT_INVITED)
  preferredContactTime String?
  notes                String?
  updatedAt            DateTime                 @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("interview_consents")
}

enum InterviewMode {
  PHONE_CALL
  WHATSAPP_CALL
  GOOGLE_MEET
  ZOOM
  IN_PERSON
  OTHER
}

enum InterviewRecordStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// Many per Participant — a reschedule is a new row, not an overwrite, so
// interview history stays intact.
model Interview {
  id                  String                @id @default(uuid())
  participantId       String
  interviewerId       String?
  interviewMode       InterviewMode?
  status              InterviewRecordStatus @default(SCHEDULED)
  scheduledAt         DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  durationMinutes     Int?
  recordingConsent    Boolean?
  recordingAvailable  Boolean               @default(false)
  transcriptAvailable Boolean               @default(false)
  summary             String?
  // Flexible free-form tags (e.g. "streamer trust", "prize motivation") —
  // deliberately not a fixed enum/taxonomy, per the research design.
  themes              String[]
  researcherNotes     String?
  transcriptFileUrl   String?
  recordingFileUrl    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  interviewer User?       @relation(fields: [interviewerId], references: [id])

  @@index([participantId])
  @@map("interviews")
}

enum ExclusionReason {
  INCOMPLETE
  DUPLICATE
  TECHNICAL_ERROR
  TEST_ACCOUNT
  INVALID_SUBMISSION
  PARTICIPANT_DECLINED_DATA_USE
  PARTICIPANT_WITHDREW
  OTHER
}

// Never auto-populated — eligible defaults true, and only a researcher's
// explicit action ever sets eligible=false / exclusionReason.
model ResearchEligibility {
  id               String           @id @default(uuid())
  participantId    String           @unique
  eligible         Boolean          @default(true)
  exclusionReason  ExclusionReason?
  excludedAt       DateTime?
  excludedByUserId String?
  reviewNotes      String?
  updatedAt        DateTime         @updatedAt

  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  excludedByUser User?       @relation(fields: [excludedByUserId], references: [id])

  @@map("research_eligibility")
}

// ===========================================================================
// Revised study flow (2026-10). One consistent experience per stream session,
// separate visitor / visit / submission records, campaign-wide duplicate
// classification, server-authoritative spin, and a separate reward draw.
// Legacy Participant-based records above are kept untouched for history.
// ===========================================================================

enum DuplicateScope {
  CAMPAIGN
}

enum StreamSessionType {
  // Condition A: normal livestream, no study link — platform metrics only.
  NORMAL_BASELINE
  // Condition B: study livestream with the website link in the description.
  STUDY
}

enum StreamSessionStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

// TEST sessions accept synthetic submissions while study policy is still
// pending; LIVE requires every collection/reward policy to be approved.
enum CollectionMode {
  TEST
  LIVE
}

enum CollaboratorRole {
  RESEARCHER
  VIEWER
}

// Researchers other than the owner who may access an experiment. VIEWER can
// read aggregate and pseudonymous data but cannot reveal or export contacts.
model ExperimentCollaborator {
  id           String           @id @default(uuid())
  experimentId String
  userId       String
  role         CollaboratorRole @default(VIEWER)
  createdAt    DateTime         @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experimentId, userId])
  @@map("experiment_collaborators")
}

// ---------------------------------------------------------------------------
// Pending supervisor/ethics decisions, made explicit. A LIVE session cannot
// be activated (and a live draw cannot run) until the required keys are
// APPROVED. Every change is appended to the audit log.
// ---------------------------------------------------------------------------

enum StudyPolicyKey {
  COLLECTION_NOTICE
  PARTIAL_DISCLOSURE
  UNDER18_COLLECTION
  UNDER18_CONTACT_AND_REWARD
  RETENTION
  REWARD_PRESENTATION
  WINNER_COUNT
  DRAW_INTERVIEW_ORDER
  UNREACHABLE_HANDLING
}

enum PolicyStatus {
  PENDING
  APPROVED
}

model StudyPolicyDecision {
  id           String         @id @default(uuid())
  experimentId String
  key          StudyPolicyKey
  status       PolicyStatus   @default(PENDING)
  // Key-specific structured value, e.g. { winnerCount: 20 } or retention days.
  value        Json?
  note         String?
  approvalRef  String?
  decidedById  String?
  decidedAt    DateTime?
  updatedAt    DateTime       @updatedAt

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  decidedBy  User?      @relation(fields: [decidedById], references: [id])

  @@unique([experimentId, key])
  @@map("study_policy_decisions")
}

// ---------------------------------------------------------------------------
// Session configuration snapshots — immutable; an edit creates a new version
// and the session's currentConfigId moves. Visits and submissions keep the id
// of the version they were shown.
// ---------------------------------------------------------------------------

model SessionConfig {
  id                  String   @id @default(uuid())
  streamSessionId     String
  version             Int
  streamerDisplayName String
  streamerImageUrl    String?
  welcomeText         String
  channelUrl          String?
  platform            String?
  // { heroHeadline, heroSubtext, howItWorks: string[], faqItems: {q,a}[] }
  homepageContent     Json
  // { mechanism: "FIXED", fixedResultKey: "bkash_reward", displayItems: {key,label,sub,tier}[],
  //   fixedResultKey?, resultHeadline, resultExplanation }
  rewardConfig        Json
  createdById         String?
  createdAt           DateTime @default(now())

  streamSession StreamSession  @relation("SessionConfigs", fields: [streamSessionId], references: [id], onDelete: Restrict)
  currentFor    StreamSession? @relation("CurrentSessionConfig")
  createdBy     User?          @relation(fields: [createdById], references: [id])
  visits        Visit[]
  submissions   Submission[]
  spins         SpinOutcome[]

  @@unique([streamSessionId, version])
  @@map("session_configs")
}

// Log of actual start/end corrections (and entry-close actions).
model SessionTimingChange {
  id              String    @id @default(uuid())
  streamSessionId String
  field           String
  previousValue   DateTime?
  newValue        DateTime?
  reason          String?
  changedById     String?
  changedAt       DateTime  @default(now())

  streamSession StreamSession @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)

  @@index([streamSessionId])
  @@map("session_timing_changes")
}

// ---------------------------------------------------------------------------
// Visitors, visits and engagement
// ---------------------------------------------------------------------------

// A first-party browser identifier — NOT a person. The cookie holds a random
// opaque token; only its SHA-256 is stored, so the table can't be used to
// impersonate a browser.
model BrowserVisitor {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  visits      Visit[]
  submissions Submission[]

  @@map("browser_visitors")
}

enum AttributionSource {
  // ?ref= code of a tracking link belonging to the active session.
  TRACKING_LINK
  // No ref: attributed to whichever session was active.
  ACTIVE_SESSION
  // ?ref= code of a link for a different/older session — shown the active
  // session, but kept distinguishable instead of credited to the old link.
  STALE_TRACKING_LINK
  // ?ref= code that matches no tracking link.
  UNKNOWN_TRACKING_CODE
}

// A visit = consecutive activity by one browser on one session, ending after
// VISIT_INACTIVITY_TIMEOUT_MS (30 min, src/lib/study/constants.ts) without any
// event/heartbeat. Created only by client-side JS (startVisit), so server
// renders and link-preview bots do not create visits.
model Visit {
  id                String            @id @default(uuid())
  visitorId         String
  experimentId      String
  streamSessionId   String
  configId          String
  attributionSource AttributionSource
  trackingLinkId    String?
  // For STALE_TRACKING_LINK / UNKNOWN_TRACKING_CODE: the code as received (max 64 chars).
  receivedRefCode   String?
  referrerHost      String?
  startedAt         DateTime          @default(now())
  lastSeenAt        DateTime          @default(now())
  // Estimated visible time: heartbeat-credited, capped per interval, merged
  // across tabs (never summed per tab). See src/lib/study/activity.ts.
  activeMs          Int               @default(0)
  activeCreditAt    DateTime?

  visitor       BrowserVisitor @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  experiment    Experiment     @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  streamSession StreamSession  @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  config        SessionConfig  @relation(fields: [configId], references: [id], onDelete: Restrict)
  trackingLink  TrackingLink?  @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)

  events      StudyEvent[]
  spin        SpinOutcome?
  submissions Submission[]

  @@index([visitorId, streamSessionId, lastSeenAt])
  @@index([streamSessionId, startedAt])
  @@index([experimentId])
  @@map("visits")
}

enum StudyEventType {
  LANDING_VIEWED
  REWARD_SECTION_VIEWED
  SPIN_CLICKED
  SPIN_COMPLETED
  FORM_OPENED
  FIELD_INTERACTED
  FORM_CLOSED
  SUBMISSION_ATTEMPTED
  SUBMISSION_REJECTED
  SUBMISSION_SAVED
  DUPLICATE_CLASSIFIED
  CONFIRMATION_VIEWED
  PAGE_HIDDEN
  PAGE_VISIBLE
}

// Bounded, server-validated events. `element` is restricted to a whitelist
// (field names / section ids) and `detail` is built server-side only — never
// field values, keystrokes, or contact details.
model StudyEvent {
  id              String         @id @default(uuid())
  visitId         String
  experimentId    String
  streamSessionId String
  submissionId    String?
  type            StudyEventType
  element         String?
  detail          Json?
  occurredAt      DateTime       @default(now())

  visit         Visit         @relation(fields: [visitId], references: [id], onDelete: Restrict)
  experiment    Experiment    @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  streamSession StreamSession @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  submission    Submission?   @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([streamSessionId, occurredAt])
  @@index([visitId])
  @@index([type])
  @@map("study_events")
}

// Server-authoritative spin result, persisted when the spin happens. One per
// visit: repeated clicks return the same stored outcome.
model SpinOutcome {
  id              String   @id @default(uuid())
  visitId         String   @unique
  streamSessionId String
  configId        String
  // Recorded honestly: FIXED when the configured result is predetermined.
  mechanism       String
  resultKey       String
  resultLabel     String
  createdAt       DateTime @default(now())

  visit         Visit         @relation(fields: [visitId], references: [id], onDelete: Restrict)
  streamSession StreamSession @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  config        SessionConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  submissions   Submission[]

  @@map("spin_outcomes")
}

// ---------------------------------------------------------------------------
// Submissions and duplicates
// ---------------------------------------------------------------------------

enum AgeGroup {
  BELOW_18
  AGE_18_30
  AGE_31_PLUS
}

enum SocialContactType {
  DISCORD
  FACEBOOK
}

enum SubmissionStatus {
  CANONICAL
  DUPLICATE
}

enum ExclusionCategory {
  INCOMPLETE
  TECHNICAL_ERROR
  TEST_ENTRY
  INVALID_SUBMISSION
  PARTICIPANT_WITHDREW
  OTHER
}

// Every genuine submission is its own row — repeats are never overwritten.
model Submission {
  id                String             @id @default(uuid())
  responseCode      String             @unique
  // Per-browser idempotency key from the form: a network retry or double
  // click with the same key returns the original row instead of a new one.
  idempotencyKey    String
  experimentId      String
  streamSessionId   String
  configId          String
  visitId           String
  visitorId         String
  spinOutcomeId     String?
  attributionSource AttributionSource
  trackingLinkId    String?
  isTest            Boolean
  // HMAC of the canonical +E.164 phone (src/lib/study/phone.ts). Not unique:
  // duplicates must be storable.
  phoneHash         String
  ageGroup          AgeGroup
  emailProvided     Boolean            @default(false)
  ignProvided       Boolean            @default(false)
  socialType        SocialContactType?
  socialProvided    Boolean            @default(false)
  status            SubmissionStatus
  canonicalId       String?
  submittedAt       DateTime           @default(now())

  // Research-analysis exclusion (separate from reward eligibility).
  researchExcluded        Boolean            @default(false)
  researchExclusionReason ExclusionCategory?
  researchExclusionNote   String?
  // Reward-draw exclusion (separate from research eligibility).
  drawExcluded            Boolean            @default(false)
  drawExclusionNote       String?
  // Research data removed after a decline/withdrawal (events, optional fields).
  researchDataPurgedAt    DateTime?

  experiment    Experiment     @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  streamSession StreamSession  @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  config        SessionConfig  @relation(fields: [configId], references: [id], onDelete: Restrict)
  visit         Visit          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  visitor       BrowserVisitor @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  spinOutcome   SpinOutcome?   @relation(fields: [spinOutcomeId], references: [id], onDelete: SetNull)
  trackingLink  TrackingLink?  @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  canonical     Submission?    @relation("DuplicateOf", fields: [canonicalId], references: [id], onDelete: Restrict)
  duplicates    Submission[]   @relation("DuplicateOf")

  contact     SubmissionContact?
  phoneEntry  CampaignPhoneEntry?
  events      StudyEvent[]
  permissions DataUsePermission[]
  followUp    SubmissionFollowUp?
  attempts    SubmissionContactAttempt[]
  interviews  SubmissionInterview[]
  drawWins    DrawWinner[]

  @@unique([visitorId, idempotencyKey])
  @@index([experimentId, phoneHash])
  @@index([streamSessionId, submittedAt])
  @@index([canonicalId])
  @@map("submissions")
}

// One row per (campaign, phone hash): the race-safe canonical claim. The
// primary key makes concurrent first submissions serialize; the loser is
// classified as a duplicate of the winner.
model CampaignPhoneEntry {
  experimentId          String
  phoneHash             String
  scope                 DuplicateScope @default(CAMPAIGN)
  canonicalSubmissionId String         @unique
  createdAt             DateTime       @default(now())

  experiment Experiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  canonical  Submission @relation(fields: [canonicalSubmissionId], references: [id], onDelete: Restrict)

  @@id([experimentId, phoneHash])
  @@map("campaign_phone_entries")
}

// Encrypted contact values for one submission, separable so it can be purged
// independently. phoneTail (last 2 digits) supports a masked display only.
model SubmissionContact {
  id               String    @id @default(uuid())
  submissionId     String    @unique
  encryptedPhone   String?
  phoneTail        String?
  encryptedEmail   String?
  encryptedIgn     String?
  encryptedSocial  String?
  phonePurgedAt    DateTime?
  optionalPurgedAt DateTime?
  createdAt        DateTime  @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@map("submission_contacts")
}

// ---------------------------------------------------------------------------
// Permissions (append-only history; current state = latest row per type)
// ---------------------------------------------------------------------------

enum PermissionType {
  INTERVIEW_PROCEED
  WEBSITE_DATA_USE
  INTERVIEW_ANSWERS_USE
}

enum PermissionStatus {
  PENDING
  GRANTED
  DECLINED
  WITHDRAWN
}

enum RecordMethod {
  PHONE_CALL
  WHATSAPP
  SMS
  IN_PERSON
  OTHER
}

model DataUsePermission {
  id            String           @id @default(uuid())
  submissionId  String
  type          PermissionType
  status        PermissionStatus
  noticeVersion String
  method        RecordMethod
  note          String?
  recordedById  String
  recordedAt    DateTime         @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  recordedBy User       @relation(fields: [recordedById], references: [id])

  @@index([submissionId, type, recordedAt])
  @@map("data_use_permissions")
}

// ---------------------------------------------------------------------------
// Follow-up (phone interview) for submissions
// ---------------------------------------------------------------------------

enum FollowUpStatus {
  NOT_CONTACTED
  ATTEMPTING
  REACHED
  INTERVIEW_COMPLETED
  DECLINED_INTERVIEW
  UNREACHABLE
}

model SubmissionFollowUp {
  id             String         @id @default(uuid())
  submissionId   String         @unique
  status         FollowUpStatus @default(NOT_CONTACTED)
  assignedToId   String?
  nextFollowupAt DateTime?
  notes          String?
  updatedAt      DateTime       @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  assignedTo User?      @relation(fields: [assignedToId], references: [id])

  @@map("submission_follow_ups")
}

model SubmissionContactAttempt {
  id           String         @id @default(uuid())
  submissionId String
  attemptedAt  DateTime       @default(now())
  outcome      ContactOutcome
  method       RecordMethod   @default(PHONE_CALL)
  note         String?
  researcherId String

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  researcher User       @relation(fields: [researcherId], references: [id])

  @@index([submissionId])
  @@map("submission_contact_attempts")
}

model SubmissionInterview {
  id              String                @id @default(uuid())
  submissionId    String
  interviewerId   String
  mode            InterviewMode         @default(PHONE_CALL)
  status          InterviewRecordStatus @default(SCHEDULED)
  scriptVersion   String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
  summary         String?
  themes          String[]
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  submission  Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  interviewer User       @relation(fields: [interviewerId], references: [id])

  @@index([submissionId])
  @@map("submission_interviews")
}

// ---------------------------------------------------------------------------
// Reward draw (BDT 100 bKash per winner) — separate from the wheel display
// ---------------------------------------------------------------------------

enum DrawStatus {
  FINALIZED
  VOIDED
}

model RewardDraw {
  id                   String     @id @default(uuid())
  experimentId         String
  isTest               Boolean
  status               DrawStatus @default(FINALIZED)
  // "<experimentId>:<test|live>" while FINALIZED, null once voided — the
  // unique constraint prevents a second finalized draw (accidental rerun).
  finalizedKey         String?    @unique
  requestedWinnerCount Int
  eligibleCount        Int
  // [{ submissionId, responseCode }] in the order considered.
  eligibleSnapshot     Json
  method               String
  executedById         String
  executedAt           DateTime   @default(now())
  voidedAt             DateTime?
  voidReason           String?

  experiment Experiment   @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  executedBy User         @relation(fields: [executedById], references: [id])
  winners    DrawWinner[]

  @@index([experimentId])
  @@map("reward_draws")
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
  UNREACHABLE
}

model DrawWinner {
  id           String       @id @default(uuid())
  drawId       String
  submissionId String
  rank         Int
  payoutStatus PayoutStatus @default(PENDING)
  amountBdt    Int          @default(100)
  // bKash transaction id or similar reference — never a PIN or OTP.
  paymentRef   String?
  paidAt       DateTime?
  updatedById  String?
  updatedAt    DateTime     @updatedAt

  draw       RewardDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  updatedBy  User?      @relation(fields: [updatedById], references: [id])

  @@unique([drawId, submissionId])
  @@unique([drawId, rank])
  @@map("draw_winners")
}

// ---------------------------------------------------------------------------
// Platform metrics (entered/imported; not measured by this website)
// ---------------------------------------------------------------------------

model PlatformMetric {
  id                     String    @id @default(uuid())
  streamSessionId        String
  platform               String
  platformStreamId       String?
  durationMinutes        Int?
  views                  Int?
  avgConcurrentViewers   Int?
  peakConcurrentViewers  Int?
  watchTimeMinutes       Int?
  avgViewDurationSeconds Int?
  likes                  Int?
  comments               Int?
  shares                 Int?
  newFollowers           Int?
  // e.g. "YouTube Studio export", "Facebook Insights", "manual observation".
  source                 String
  measuredAt             DateTime
  windowStart            DateTime?
  windowEnd              DateTime?
  notes                  String?
  recordedById           String?
  createdAt              DateTime  @default(now())

  streamSession StreamSession @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  recordedBy    User?         @relation(fields: [recordedById], references: [id])

  @@index([streamSessionId])
  @@map("platform_metrics")
}

enum AnnotationType {
  STREAM_START
  STREAM_END
  CHAT_QUESTION
  CHAT_ANSWER
  LINK_SHARED
  OTHER
}

model SessionAnnotation {
  id              String         @id @default(uuid())
  streamSessionId String
  type            AnnotationType
  occurredAt      DateTime
  note            String
  createdById     String?
  createdAt       DateTime       @default(now())

  streamSession StreamSession @relation(fields: [streamSessionId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation(fields: [createdById], references: [id])

  @@index([streamSessionId, occurredAt])
  @@map("session_annotations")
}

// ---------------------------------------------------------------------------
// Audit log and rate limiting
// ---------------------------------------------------------------------------

// Who did what to which record. `detail` must never contain contact values.
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  experimentId String?
  detail       Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([experimentId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Fixed-window counters keyed by an HMAC of (scope, visitor or IP) — the raw
// IP is never stored.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int

  @@map("rate_limit_buckets")
}

// Images uploaded from the researcher panel (e.g. streamer photos for the
// homepage). Stored in the database — already resized client-side and
// size-limited server-side — and served by /api/media/[id].
model MediaAsset {
  id          String   @id @default(uuid())
  mimeType    String
  bytes       Bytes
  sizeBytes   Int
  purpose     String
  createdById String?
  createdAt   DateTime @default(now())

  @@map("media_assets")
}
